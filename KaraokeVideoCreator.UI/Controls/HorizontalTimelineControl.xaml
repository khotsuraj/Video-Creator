<UserControl x:Class="KaraokeVideoCreator.UI.Controls.HorizontalTimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="800">

    <Grid Background="{StaticResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Timeline Header Strip -->
            <RowDefinition Height="*"/>    <!-- Scrollable Horizontal Timeline Area -->
        </Grid.RowDefinitions>

        <!-- Header Strip -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="10,4">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="TIMELINE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" (Horizontal)" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out Timeline" Style="{StaticResource ToolbarButtonStyle}" Padding="6,2" Margin="0,0,2,0">
                        <TextBlock Text="−" FontSize="12" FontWeight="Bold"/>
                    </Button>
                    <Button Command="{Binding ZoomInCommand}" ToolTip="Zoom In Timeline" Style="{StaticResource ToolbarButtonStyle}" Padding="6,2" Margin="0,0,12,0">
                        <TextBlock Text="+" FontSize="12" FontWeight="Bold"/>
                    </Button>
                    <TextBlock Text="{Binding CurrentPositionFormatted}" FontFamily="Consolas, Cascadia Code" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Scrollable Horizontal Timeline Canvas Area -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="TimelineScrollViewer" 
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Disabled"
                          Background="{StaticResource PanelBackgroundBrush}"
                          PreviewMouseWheel="OnTimelinePreviewMouseWheel">
                <Canvas x:Name="TimelineCanvas" 
                        Width="2400" 
                        Height="140" 
                        Background="{StaticResource WindowBackgroundBrush}"
                        MouseDown="OnCanvasMouseDown"
                        MouseMove="OnCanvasMouseMove"
                        MouseUp="OnCanvasMouseUp"
                        Cursor="Hand">

                    <!-- Track Separator Lines -->
                    <Line X1="0" Y1="28" X2="2400" Y2="28" Stroke="{StaticResource CardBorderBrush}" StrokeThickness="1"/>
                    <Line X1="0" Y1="84" X2="2400" Y2="84" Stroke="{StaticResource CardBorderBrush}" StrokeThickness="1"/>

                    <!-- Track Labels -->
                    <TextBlock Text="RULER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDisabledBrush}" Canvas.Left="6" Canvas.Top="6"/>
                    <TextBlock Text="WAVEFORM" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDisabledBrush}" Canvas.Left="6" Canvas.Top="34"/>
                    <TextBlock Text="LYRICS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDisabledBrush}" Canvas.Left="6" Canvas.Top="90"/>

                    <!-- Moving Vertical Playhead Container -->
                    <Canvas x:Name="PlayheadContainer" Canvas.Left="0" Canvas.Top="0" Width="24" Height="140" Panel.ZIndex="20">
                        <!-- Full Vertical Red Playhead Line -->
                        <Line X1="12" Y1="0" X2="12" Y2="140" Stroke="{StaticResource PlayheadBrush}" StrokeThickness="2"/>
                        
                        <!-- Top Triangle Handle -->
                        <Polygon Points="6,0 18,0 12,8" Fill="{StaticResource PlayheadBrush}"/>

                        <!-- Time Badge over Playhead -->
                        <Border Background="{StaticResource PlayheadBrush}" CornerRadius="2" Padding="4,1" Canvas.Left="-16" Canvas.Top="10">
                            <TextBlock x:Name="PlayheadTimeText" Text="00:00.000" Foreground="#FFFFFF" FontSize="9" FontFamily="Consolas, Cascadia Code" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                    </Canvas>
                </Canvas>
            </ScrollViewer>

            <!-- Empty State Overlay when no audio loaded -->
            <Border Background="{StaticResource PanelBackgroundBrush}" Visibility="{Binding HasAudio, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="No Audio Track Loaded" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Import an audio file to display horizontal audio &amp; lyrics timeline." FontSize="11" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
