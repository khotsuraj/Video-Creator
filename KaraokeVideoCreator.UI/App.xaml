<Application x:Class="KaraokeVideoCreator.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KaraokeVideoCreator.UI.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml"/>
                <ResourceDictionary Source="Theme/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisConverter x:Key="BoolToVis"/>
            <converters:BoolToVisConverter x:Key="InverseBoolToVis" IsInverted="True"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
